# Copy to .env and fill in only what you need. .env is git-ignored - never commit real values.

# ================= GATEWAY (team machine only) =================
# The API key lives ONLY here. The netcheck app that users run never sees it.
ANTHROPIC_API_KEY=
# claude (default) | ollama (optional local model)
NETCHECK_GATEWAY_BACKEND=claude
NETCHECK_GATEWAY_CLAUDE_MODEL=claude-haiku-5-5
# Haiku 5.5 thinks by default and thinking tokens count against the output limit; we keep it off (fast, cheap)
NETCHECK_GATEWAY_CLAUDE_THINKING=
NETCHECK_GATEWAY_CLAUDE_EFFORT=low
NETCHECK_GATEWAY_MAX_OUTPUT_TOKENS=1024
NETCHECK_GATEWAY_HOST=127.0.0.1
NETCHECK_GATEWAY_PORT=8787
# required if the gateway is reachable from other machines (tunnel / non-local bind)
NETCHECK_GATEWAY_TOKEN=
NETCHECK_GATEWAY_RATE_PER_MIN=12
# hard cap on model calls per day - protects your API credits
NETCHECK_GATEWAY_DAILY_LIMIT=2000
# set to 1 when behind Cloudflare Tunnel / a reverse proxy
NETCHECK_GATEWAY_TRUST_PROXY=
# only for NETCHECK_GATEWAY_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
NETCHECK_GATEWAY_OLLAMA_MODEL=qwen3.5:9b

# ================= APP (end users need none of this) =================
# gateway | none
NETCHECK_LLM_PROVIDER=gateway
NETCHECK_AI_URL=http://127.0.0.1:8787
NETCHECK_AI_TOKEN=
NETCHECK_AI_TIMEOUT=30
