# Copy to .env and fill in locally. NEVER commit .env.
# AI provider: ollama (default, free, local — scan data never leaves the laptop) | anthropic | off
NETCHECK_LLM=ollama
NETCHECK_OLLAMA_MODEL=qwen2.5:7b
NETCHECK_OLLAMA_URL=http://127.0.0.1:11434
# Only if NETCHECK_LLM=anthropic (paid API account):
ANTHROPIC_API_KEY=
NETCHECK_MODEL=claude-opus-5-5
# Optional: extra private ranges allowed for live scans (comma separated). Default = connected subnet only.
NETCHECK_ALLOWLIST=
# Optional: where history, device secret and signing key live (default ~/.netcheck)
NETCHECK_HOME=
